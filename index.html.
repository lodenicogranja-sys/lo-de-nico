<script>
/* PARTE 2: pedidos y administración */

document.getElementById("formPedido").addEventListener("submit", async function(e) {
  e.preventDefault();

  const resultado = document.getElementById("resultado");
  if (!db) {
    resultado.innerHTML = '<div class="mensaje">Falta configurar la clave pública de Supabase.</div>';
    return;
  }

  const items = Object.entries(carrito)
    .filter(([id,q]) => q > 0 && productos.some(p => String(p.id) === id))
    .map(([id,q]) => ({product_id:Number(id), quantity:q}));

  if (!items.length) {
    resultado.innerHTML = '<div class="mensaje">Agregá productos al carrito antes de enviar el pedido.</div>';
    return;
  }

  const nombre = document.getElementById("nombre").value.trim();
  const telefono = document.getElementById("telefono").value.trim();
  const entrega = document.getElementById("entrega").value;
  const direccion = entrega === "delivery" ? document.getElementById("direccion").value.trim() : null;
  const pago = document.getElementById("pago").value;

  if (!nombre || !telefono || (entrega === "delivery" && !direccion)) {
    resultado.innerHTML = '<div class="mensaje">Completá los campos obligatorios.</div>';
    return;
  }

  const boton = this.querySelector('button[type="submit"]');
  boton.disabled = true;
  boton.textContent = "Enviando pedido...";

  try {
    const {data,error} = await db.rpc("create_store_order", {
      p_customer_name:nombre,
      p_customer_phone:telefono,
      p_customer_email:document.getElementById("correo").value.trim() || null,
      p_fulfillment:entrega,
      p_payment_method:pago,
      p_delivery_address:direccion,
      p_delivery_notes:document.getElementById("notas").value.trim() || null,
      p_items:items
    });

    if (error) throw error;
    if (data && data.success === false) {
      throw new Error(data.message || "No se pudo crear el pedido.");
    }

    const numero = data?.order_number || data?.order?.order_number || data?.order_id || data?.id || "registrado";
    const detalle = items.map(i => {
      const p = productos.find(x => Number(x.id) === i.product_id);
      return `${p.name} x ${i.quantity} — ${dinero(Number(p.price)*i.quantity)}`;
    }).join("\n");

    const resumen = `Hola, Lo de Nico. Hice el pedido ${numero}.\nNombre: ${nombre}\nTeléfono: ${telefono}\nEntrega: ${entrega === "pickup" ? "Retiro" : "Envío"}\nDirección: ${direccion || "A coordinar"}\nPago: ${pago === "cash" ? "Efectivo" : "Transferencia"}\n${detalle}\nSubtotal estimado: ${dinero(totalCarrito())}\nPor favor, confirmame disponibilidad y total final.`;

    carrito = {};
    actualizarCarrito();
    this.reset();
    actualizarEntrega();

    resultado.innerHTML = '<div class="mensaje">¡Pedido registrado! Referencia: ' +
      String(numero).replace(/[&<>"']/g, '') +
      '. Lo de Nico debe confirmar disponibilidad y total final.</div>';

    if (WHATSAPP && !WHATSAPP.startsWith("REEMPLAZAR")) {
      const link = document.createElement("a");
      link.className = "btn";
      link.style.marginTop = "10px";
      link.target = "_blank";
      link.rel = "noopener";
      link.href = "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(resumen);
      link.textContent = "Enviar resumen por WhatsApp";
      resultado.appendChild(link);
    }
  } catch (err) {
    console.error(err);
    resultado.innerHTML = '<div class="mensaje">No se pudo registrar el pedido. Revisá la conexión e intentá nuevamente.</div>';
  } finally {
    boton.disabled = false;
    boton.textContent = "Enviar pedido";
  }
});

async function iniciarAdmin() {
  const mensaje = document.getElementById("mensajeAdmin");
  mensaje.textContent = "";

  if (!db) {
    mensaje.textContent = "Primero configurá la clave pública de Supabase.";
    return;
  }

  const email = document.getElementById("adminCorreo").value.trim();
  const password = document.getElementById("adminClave").value;
  const {data,error} = await db.auth.signInWithPassword({email,password});

  if (error) {
    mensaje.textContent = "No se pudo iniciar sesión. Revisá el correo y la contraseña.";
    return;
  }

  const {data:admin,error:adminError} = await db
    .from("admin_users")
    .select("user_id")
    .eq("user_id",data.user.id)
    .maybeSingle();

  if (adminError || !admin) {
    await db.auth.signOut();
    mensaje.textContent = "Esta cuenta no está autorizada como administradora.";
    return;
  }

  usuarioAdmin = data.user;
  document.getElementById("loginAdmin").classList.add("oculto");
  document.getElementById("panelAdmin").classList.remove("oculto");
  await cargarPanelAdmin();
}

async function cerrarAdmin() {
  if (db) await db.auth.signOut();
  usuarioAdmin = null;
  document.getElementById("panelAdmin").classList.add("oculto");
  document.getElementById("loginAdmin").classList.remove("oculto");
}

async function cargarPanelAdmin() {
  const zona = document.getElementById("contenidoAdmin");
  zona.innerHTML = "<p>Cargando panel...</p>";

  const {data:pedidos,error} = await db
    .from("orders").select("*")
    .order("created_at",{ascending:false}).limit(100);

  if (error) {
    zona.textContent = "No se pudieron cargar los pedidos. Revisá las políticas de Supabase.";
    return;
  }

  zona.innerHTML = `
    <h3>Pedidos recibidos</h3>
    <button type="button" onclick="cargarPanelAdmin()">Actualizar pedidos</button>
    <div style="overflow:auto">
      <table style="width:100%;border-collapse:collapse;margin-top:12px">
        <thead><tr>
          <th style="text-align:left;padding:8px">Pedido</th>
          <th style="text-align:left;padding:8px">Cliente</th>
          <th style="text-align:left;padding:8px">Total</th>
          <th style="text-align:left;padding:8px">Estado</th>
          <th style="text-align:left;padding:8px">Acción</th>
        </tr></thead>
        <tbody>
        ${(pedidos||[]).map(p=>`
          <tr>
            <td style="padding:8px;border-top:1px solid #ddd">${String(p.order_number||p.id).replace(/[&<>"']/g,"")}</td>
            <td style="padding:8px;border-top:1px solid #ddd">${String(p.customer_name||"").replace(/[&<>"']/g,"")}<br>${String(p.customer_phone||"").replace(/[&<>"']/g,"")}</td>
            <td style="padding:8px;border-top:1px solid #ddd">${dinero(p.total)}</td>
            <td style="padding:8px;border-top:1px solid #ddd">${String(p.order_status||"pendiente").replace(/[&<>"']/g,"")}</td>
            <td style="padding:8px;border-top:1px solid #ddd">
              <button type="button" onclick="confirmarPedido(${Number(p.id)})" ${p.order_status==="confirmed"||p.order_status==="cancelled"?"disabled":""}>Confirmar pedido</button>
            </td>
          </tr>`).join("")}
        </tbody>
      </table>
    </div>
    <hr>
    <h3>Productos</h3>
    <p>Desde esta sección podés revisar el catálogo y agregar productos.</p>
    <button type="button" onclick="formularioProducto()">Agregar producto</button>
    <div id="formNuevoProducto"></div>
    <div id="listaAdminProductos"></div>
  `;

  await listarProductosAdmin();
}

async function confirmarPedido(id) {
  if (!confirm("¿Confirmar el pedido y descontar las cantidades del stock?")) return;

  const {data,error} = await db.rpc("admin_confirm_store_order",{p_order_id:id});
  if (error || data?.success === false) {
    alert("No se pudo confirmar el pedido. Revisá el stock y los permisos.");
    return;
  }

  alert("Pedido confirmado.");
  await cargarPanelAdmin();
}

async function listarProductosAdmin() {
  const zona = document.getElementById("listaAdminProductos");
  const {data,error} = await db.from("products").select("*").order("name");

  if (error) {
    zona.textContent = "No se pudieron cargar los productos.";
    return;
  }

  zona.innerHTML = `<div style="overflow:auto"><table style="width:100%;border-collapse:collapse">
    <thead><tr><th>Producto</th><th>Precio</th><th>Stock</th><th>Visible</th><th>Acción</th></tr></thead>
    <tbody>${(data||[]).map(p=>`
      <tr>
        <td>${String(p.name).replace(/[&<>"']/g,"")}</td>
        <td>${dinero(p.price)}</td>
        <td>${Number(p.stock)||0}</td>
        <td>${p.active?"Sí":"No"}</td>
        <td><button type="button" onclick="cambiarVisibilidad(${Number(p.id)},${!p.active})">${p.active?"Ocultar":"Mostrar"}</button></td>
      </tr>`).join("")}</tbody></table></div>`;
}

async function cambiarVisibilidad(id,activo) {
  const {error} = await db.from("products")
    .update({active:activo,updated_at:new Date().toISOString()})
    .eq("id",id);

  if (error) {
    alert("No se pudo cambiar la visibilidad del producto.");
    return;
  }
  await listarProductosAdmin();
}

async function formularioProducto() {
  const zona = document.getElementById("formNuevoProducto");
  const {data:cats,error} = await db.from("categories").select("*").order("sort_order");

  if (error) {
    zona.textContent = "No se pudieron cargar las categorías.";
    return;
  }

  zona.innerHTML = `
    <form id="nuevoProducto" class="panel" style="margin-top:12px">
      <h3>Nuevo producto</h3>
      <label>Nombre</label><input id="npNombre" required maxlength="140">
      <label>Categoría</label>
      <select id="npCategoria" required>${(cats||[]).map(c=>`<option value="${Number(c.id)}">${String(c.name).replace(/[&<>"']/g,"")}</option>`).join("")}</select>
      <label>Descripción</label><textarea id="npDescripcion" rows="2"></textarea>
      <label>Precio en pesos</label><input id="npPrecio" type="number" min="0" step="0.01" required>
      <label>Unidad (kg, bandeja, unidad…)</label><input id="npUnidad" value="kg" required>
      <label>Stock</label><input id="npStock" type="number" min="0" step="0.01" value="0">
      <label>URL de fotografía (opcional)</label><input id="npImagen" type="url" placeholder="https://...">
      <button type="submit" class="principal">Guardar producto</button>
      <div id="npResultado"></div>
    </form>`;

  document.getElementById("nuevoProducto").onsubmit = async function(e) {
    e.preventDefault();
    const fila = {
      name:document.getElementById("npNombre").value.trim(),
      category_id:Number(document.getElementById("npCategoria").value),
      description:document.getElementById("npDescripcion").value.trim(),
      price:Number(document.getElementById("npPrecio").value),
      unit:document.getElementById("npUnidad").value.trim(),
      stock:Number(document.getElementById("npStock").value)||0,
      image_url:document.getElementById("npImagen").value.trim()||null,
      active:true,featured:false
    };

    const {error} = await db.from("products").insert(fila);
    if (error) {
      document.getElementById("npResultado").textContent = "Error al guardar. Revisá los datos y los permisos.";
      return;
    }

    alert("Producto agregado.");
    await cargarCatalogo();
    await cargarPanelAdmin();
  };
}

actualizarEntrega();
cargarCatalogo();
</script>

</body>
</html>
