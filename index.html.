<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#173d2c">
<title>Lo de Nico | Tienda online</title>
<style>
:root{--verde:#173d2c;--verde2:#24563e;--crema:#fbf8ef;--lima:#d9ed8b;--borde:#e2e6db}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:var(--crema);color:#203127}
header{background:var(--verde);color:white;padding:18px 5%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
header h1{margin:0;font-size:25px}
header p{margin:5px 0 0;color:#e1eadf}
button,a.btn{border:0;border-radius:10px;padding:12px 16px;font-weight:bold;cursor:pointer;text-decoration:none;display:inline-block}
button:disabled{opacity:.6;cursor:not-allowed}
.btn{background:var(--lima);color:var(--verde)}
main{max-width:1100px;margin:auto;padding:22px 16px}
.hero{background:var(--verde);color:white;border-radius:22px;padding:30px 24px;margin-bottom:28px}
.hero h2{font-size:clamp(30px,6vw,48px);margin:8px 0}
.hero p{line-height:1.5;max-width:560px}
h2,h3{color:var(--verde)}
.hero h2{color:white}
input,select,textarea{width:100%;padding:12px;border:1px solid var(--borde);border-radius:10px;font:inherit;margin:5px 0 12px;background:white}
.categorias{display:flex;gap:8px;flex-wrap:wrap;margin:15px 0}
.categoria{background:white;border:1px solid var(--borde);color:var(--verde)}
.categoria.activa{background:var(--verde);color:white}
.productos{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}
.producto,.panel{background:white;border:1px solid var(--borde);border-radius:16px;padding:15px}
.foto{width:100%;height:145px;object-fit:cover;background:#edf0e6;border-radius:11px;display:grid;place-items:center;font-size:48px;overflow:hidden}
.producto h3{margin-bottom:5px}
.precio{font-size:20px;font-weight:bold;color:var(--verde);margin:12px 0}
.producto button,.principal{width:100%;background:var(--verde);color:white}
.seccion{margin:30px 0}
.doscolumnas{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.lineacarrito{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid var(--borde);padding:10px 0}
.mensaje{padding:12px;background:#edf4df;border-radius:10px;margin-top:12px;overflow-wrap:anywhere}
.oculto{display:none!important}
footer{background:var(--verde);color:white;padding:25px 5%;margin-top:35px}
footer a{color:var(--lima)}
table{font-size:14px}
th,td{vertical-align:top}
@media(max-width:650px){.doscolumnas{grid-template-columns:1fr}header h1{font-size:22px}.hero{padding:23px 18px}table{font-size:12px}th,td{padding:6px!important}}
</style>
</head>
<body>
<header>
  <div>
    <h1>🥬 Lo de Nico</h1>
    <p>Tu granja de confianza</p>
  </div>
  <button class="btn" onclick="document.getElementById('pedido').scrollIntoView({behavior:'smooth'})">🛒 Mi pedido (<span id="cantidad">0</span>)</button>
</header>

<main>
<section class="hero">
  <p>POLLO · CARNE · CERDO · CONGELADOS</p>
  <h2>Lo que necesitás, a tu manera.</h2>
  <p>Elegí tus productos, armá tu carrito y enviá tu pedido para coordinar la entrega.</p>
  <a class="btn" href="#productos">Ver productos</a>
</section>

<section id="productos" class="seccion">
  <h2>Nuestros productos</h2>
  <input id="buscar" placeholder="🔎 Buscar productos..." oninput="mostrarProductos()">
  <div id="categorias" class="categorias">
    <button type="button" class="categoria activa" onclick="filtrar('Todos',this)">Todos</button>
    <button type="button" class="categoria" onclick="filtrar('Pollo',this)">🍗 Pollo</button>
    <button type="button" class="categoria" onclick="filtrar('Carne',this)">🥩 Carne</button>
    <button type="button" class="categoria" onclick="filtrar('Cerdo',this)">🐖 Cerdo</button>
    <button type="button" class="categoria" onclick="filtrar('Congelados',this)">❄️ Congelados</button>
  </div>
  <div id="listaProductos" class="productos">
    <p>Conectando con el catálogo...</p>
  </div>
</section>

<section id="pedido" class="seccion">
  <h2>Finalizar pedido</h2>
  <div class="doscolumnas">
    <form id="formPedido" class="panel">
      <h3>Tus datos</h3>
      <label for="nombre">Nombre y apellido *</label>
      <input id="nombre" required maxlength="100" placeholder="Tu nombre">
      <label for="telefono">Teléfono / WhatsApp *</label>
      <input id="telefono" required maxlength="40" placeholder="Tu teléfono">
      <label for="correo">Correo electrónico (opcional)</label>
      <input id="correo" type="email" maxlength="160" placeholder="tu@email.com">
      <label for="entrega">Entrega *</label>
      <select id="entrega" onchange="actualizarEntrega()">
        <option value="delivery">Envío a domicilio</option>
        <option value="pickup">Retiro</option>
      </select>
      <div id="direccionGrupo">
        <label for="direccion">Dirección *</label>
        <input id="direccion" placeholder="Calle, número y localidad">
      </div>
      <label for="notas">Indicaciones adicionales</label>
      <textarea id="notas" rows="2" placeholder="Entre calles u otras indicaciones"></textarea>
      <label for="pago">Forma de pago *</label>
      <select id="pago">
        <option value="cash">Efectivo</option>
        <option value="transfer">Transferencia bancaria</option>
      </select>
      <button class="principal" type="submit">Enviar pedido</button>
      <div id="resultado" aria-live="polite"></div>
    </form>

    <div class="panel">
      <h3>🛒 Tu carrito</h3>
      <div id="carrito">Todavía no agregaste productos.</div>
      <hr>
      <h3>Subtotal: <span id="subtotal">$ 0</span></h3>
      <p>El costo de envío y la disponibilidad se confirmarán al preparar tu pedido.</p>
      <button type="button" onclick="document.getElementById('productos').scrollIntoView({behavior:'smooth'})">Seguir comprando</button>
    </div>
  </div>
</section>

<section class="seccion panel">
  <h2>¿Necesitás ayuda?</h2>
  <p>Contactá a Lo de Nico para consultar disponibilidad y coordinar tu compra.</p>
  <a href="mailto:lodenicogranja@gmail.com">lodenicogranja@gmail.com</a>
  <p><a class="btn" href="https://wa.me/5491127906272" target="_blank" rel="noopener">Contactar por WhatsApp</a></p>
</section>

<section class="seccion" id="administracion">
  <h2>Administración</h2>
  <button type="button" onclick="document.getElementById('loginAdmin').classList.toggle('oculto')">Abrir panel privado</button>
  <div id="loginAdmin" class="panel oculto">
    <h3>Acceso administrador</h3>
    <label for="adminCorreo">Correo</label>
    <input id="adminCorreo" type="email" value="lodenicogranja@gmail.com" autocomplete="username">
    <label for="adminClave">Contraseña</label>
    <input id="adminClave" type="password" autocomplete="current-password">
    <button type="button" class="principal" onclick="iniciarAdmin()">Iniciar sesión</button>
    <div id="mensajeAdmin" aria-live="polite"></div>
  </div>
  <div id="panelAdmin" class="panel oculto">
    <h3>Panel de gestión</h3>
    <button type="button" onclick="cerrarAdmin()">Cerrar sesión</button>
    <div id="contenidoAdmin"></div>
  </div>
</section>
</main>

<footer>
  <strong>Lo de Nico</strong><br>
  <span>Pollo · Carne · Cerdo · Congelados</span><br>
  <a href="mailto:lodenicogranja@gmail.com">lodenicogranja@gmail.com</a>
</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
/* =========================================================
   CONFIGURACIÓN DE LO DE NICO
   ========================================================= */

const SUPABASE_URL = "https://hqihkkbniotbaoaekclq.supabase.co";
const SUPABASE_KEY = "sb_publishable_-66kQeOxjQxlJzsTjCCVbg_gZBaekLU";
const WHATSAPP = "5491127906272";

let db = null;
let productos = [];
let categorias = [];
let carrito = {};
let categoriaActiva = "Todos";
let usuarioAdmin = null;

const dinero = n => new Intl.NumberFormat("es-AR", {
  style: "currency",
  currency: "ARS"
}).format(Number(n) || 0);

const escapar = s => String(s ?? "").replace(/[&<>"']/g, c => ({
  "&": "&amp;",
  "<": "&lt;",
  ">": "&gt;",
  '"': "&quot;",
  "'": "&#39;"
}[c]));

function conectar() {
  if (!window.supabase) {
    console.error("No se pudo cargar la librería de Supabase.");
    return false;
  }

  if (!db) {
    db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
  }

  return true;
}

function filtrar(c, boton) {
  categoriaActiva = c;

  document.querySelectorAll("#categorias .categoria").forEach(x => {
    x.classList.remove("activa");
  });

  boton.classList.add("activa");
  mostrarProductos();
}

function actualizarEntrega() {
  const retiro = document.getElementById("entrega").value === "pickup";

  document.getElementById("direccionGrupo").classList.toggle("oculto", retiro);
  document.getElementById("direccion").required = !retiro;
}

function totalCarrito() {
  return Object.entries(carrito).reduce((s, [id, q]) => {
    const producto = productos.find(p => String(p.id) === id);
    return s + (Number(producto?.price) || 0) * q;
  }, 0);
}

function actualizarCarrito() {
  const items = Object.entries(carrito).filter(([id, q]) =>
    q > 0 && productos.some(p => String(p.id) === id)
  );

  document.getElementById("cantidad").textContent =
    items.reduce((s, [, q]) => s + q, 0);

  document.getElementById("subtotal").textContent = dinero(totalCarrito());

  /* Corrección: se eliminó la asignación inválida al elemento carrito. */
  document.getElementById("carrito").innerHTML = items.length
    ? items.map(([id, q]) => {
        const p = productos.find(x => String(x.id) === id);

        return `<div class="lineacarrito">
          <div>
            <strong>${escapar(p.name)}</strong><br>
            ${dinero(p.price)} × ${q}<br>
            <button type="button" onclick="cambiarCantidad('${id}',-1)">−</button>
            <button type="button" onclick="cambiarCantidad('${id}',1)">＋</button>
          </div>
          <strong>${dinero(Number(p.price) * q)}</strong>
        </div>`;
      }).join("")
    : "Todavía no agregaste productos.";
}

function cambiarCantidad(id, diferencia) {
  carrito[id] = (carrito[id] || 0) + diferencia;

  if (carrito[id] <= 0) {
    delete carrito[id];
  }

  actualizarCarrito();
}

function agregar(id) {
  const producto = productos.find(p => String(p.id) === String(id));
  if (!producto) return;

  carrito[id] = (carrito[id] || 0) + 1;
  actualizarCarrito();
}

function mostrarProductos() {
  const busqueda = (document.getElementById("buscar").value || "")
    .toLowerCase()
    .trim();

  const lista = productos.filter(p => {
    const nombreCategoria = categorias.find(
      c => String(c.id) === String(p.category_id)
    )?.name;

    const coincideCategoria =
      categoriaActiva === "Todos" || nombreCategoria === categoriaActiva;

    const texto = `${p.name} ${p.description || ""}`.toLowerCase();

    return coincideCategoria && texto.includes(busqueda);
  });

  document.getElementById("listaProductos").innerHTML = lista.length
    ? lista.map(p => `
        <article class="producto">
          <div class="foto">
            ${p.image_url
              ? `<img src="${escapar(p.image_url)}"
                   alt="${escapar(p.name)}"
                   loading="lazy"
                   style="width:100%;height:145px;object-fit:cover;border-radius:10px">`
              : "🛍️"}
          </div>
          <h3>${escapar(p.name)}</h3>
          <p>${escapar(p.description || "Consultá disponibilidad")}</p>
          <div class="precio">${dinero(p.price)} / ${escapar(p.unit || "unidad")}</div>
          <button type="button" onclick="agregar('${String(p.id).replace(/'/g, "\\'")}')">＋ Agregar</button>
        </article>
      `).join("")
    : "<p>No hay productos disponibles en esta categoría todavía.</p>";
}

async function cargarCatalogo() {
  if (!conectar()) {
    document.getElementById("listaProductos").innerHTML =
      "<p class='mensaje'>No se pudo cargar la librería de Supabase. Revisá tu conexión a Internet.</p>";
    return;
  }

  try {
    const [resultadoCategorias, resultadoProductos] = await Promise.all([
      db.from("categories")
        .select("*")
        .eq("active", true)
        .order("sort_order"),

      db.from("products")
        .select("*")
        .eq("active", true)
        .order("name")
    ]);

    if (resultadoCategorias.error) throw resultadoCategorias.error;
    if (resultadoProductos.error) throw resultadoProductos.error;

    categorias = resultadoCategorias.data || [];
    productos = resultadoProductos.data || [];

    mostrarProductos();
    actualizarCarrito();
  } catch (error) {
    console.error("Error cargando el catálogo:", error);

    document.getElementById("listaProductos").innerHTML =
      "<p class='mensaje'>No se pudo cargar el catálogo. Revisá la conexión, las claves y las políticas de Supabase.</p>";
  }
}

/* =========================================================
   PARTE 2: PEDIDOS Y ADMINISTRACIÓN
   ========================================================= */

document.getElementById("formPedido").addEventListener("submit", async function(event) {
  event.preventDefault();

  const resultado = document.getElementById("resultado");
  resultado.replaceChildren();

  if (!conectar()) {
    resultado.innerHTML =
      '<div class="mensaje">No se pudo conectar con Supabase. Revisá la configuración.</div>';
    return;
  }

  const items = Object.entries(carrito)
    .filter(([id, cantidad]) =>
      cantidad > 0 && productos.some(p => String(p.id) === id)
    )
    .map(([id, cantidad]) => ({
      product_id: Number(id),
      quantity: cantidad
    }));

  if (!items.length) {
    resultado.innerHTML =
      '<div class="mensaje">Agregá productos al carrito antes de enviar el pedido.</div>';
    return;
  }

  const nombre = document.getElementById("nombre").value.trim();
  const telefono = document.getElementById("telefono").value.trim();
  const correo = document.getElementById("correo").value.trim() || null;
  const entrega = document.getElementById("entrega").value;
  const direccion = entrega === "delivery"
    ? document.getElementById("direccion").value.trim()
    : null;
  const pago = document.getElementById("pago").value;
  const notas = document.getElementById("notas").value.trim() || null;

  if (!nombre || !telefono || (entrega === "delivery" && !direccion)) {
    resultado.innerHTML =
      '<div class="mensaje">Completá los campos obligatorios.</div>';
    return;
  }

  const boton = this.querySelector('button[type="submit"]');
  boton.disabled = true;
  boton.textContent = "Enviando pedido...";

  try {
    const { data, error } = await db.rpc("create_store_order", {
      p_customer_name: nombre,
      p_customer_phone: telefono,
      p_customer_email: correo,
      p_fulfillment: entrega,
      p_payment_method: pago,
      p_delivery_address: direccion,
      p_delivery_notes: notas,
      p_items: items
    });

    if (error) throw error;

    if (data && data.success === false) {
      throw new Error(data.message || "No se pudo crear el pedido.");
    }

    const numero =
      data?.order_number ||
      data?.order?.order_number ||
      data?.order_id ||
      data?.id ||
      "registrado";

    const detalle = items.map(item => {
      const p = productos.find(x => Number(x.id) === item.product_id);
      return `${p.name} x ${item.quantity} — ${dinero(Number(p.price) * item.quantity)}`;
    }).join("\n");

    const resumen =
      `Hola, Lo de Nico. Hice el pedido ${numero}.\n` +
      `Nombre: ${nombre}\n` +
      `Teléfono: ${telefono}\n` +
      `Entrega: ${entrega === "pickup" ? "Retiro" : "Envío"}\n` +
      `Dirección: ${direccion || "A coordinar"}\n` +
      `Pago: ${pago === "cash" ? "Efectivo" : "Transferencia bancaria"}\n` +
      `${detalle}\n` +
      `Subtotal estimado: ${dinero(totalCarrito())}\n` +
      `Por favor, confirmame disponibilidad y total final.`;

    carrito = {};
    actualizarCarrito();
    this.reset();
    actualizarEntrega();

    resultado.innerHTML =
      '<div class="mensaje">¡Pedido registrado! Referencia: ' +
      escapar(numero) +
      '. Lo de Nico debe confirmar disponibilidad y total final.</div>';

    const enlaceWhatsApp = document.createElement("a");
    enlaceWhatsApp.className = "btn";
    enlaceWhatsApp.style.marginTop = "10px";
    enlaceWhatsApp.target = "_blank";
    enlaceWhatsApp.rel = "noopener";
    enlaceWhatsApp.href =
      "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(resumen);
    enlaceWhatsApp.textContent = "Enviar resumen por WhatsApp";
    resultado.appendChild(enlaceWhatsApp);

  } catch (error) {
    console.error("Error registrando el pedido:", error);

    resultado.innerHTML =
      '<div class="mensaje">No se pudo registrar el pedido. Revisá la conexión, las políticas de Supabase y la función de creación de pedidos.</div>';
  } finally {
    boton.disabled = false;
    boton.textContent = "Enviar pedido";
  }
});

async function iniciarAdmin() {
  const mensaje = document.getElementById("mensajeAdmin");
  mensaje.textContent = "";

  if (!conectar()) {
    mensaje.textContent = "No se pudo conectar con Supabase.";
    return;
  }

  const email = document.getElementById("adminCorreo").value.trim();
  const password = document.getElementById("adminClave").value;

  if (!email || !password) {
    mensaje.textContent = "Ingresá el correo y la contraseña.";
    return;
  }

  try {
    const { data, error } = await db.auth.signInWithPassword({
      email,
      password
    });

    if (error) {
      mensaje.textContent =
        "No se pudo iniciar sesión. Revisá el correo y la contraseña.";
      return;
    }

    const { data: admin, error: adminError } = await db
      .from("admin_users")
      .select("user_id")
      .eq("user_id", data.user.id)
      .maybeSingle();

    if (adminError || !admin) {
      await db.auth.signOut();
      mensaje.textContent =
        "Esta cuenta no está autorizada como administradora.";
      return;
    }

    usuarioAdmin = data.user;

    document.getElementById("loginAdmin").classList.add("oculto");
    document.getElementById("panelAdmin").classList.remove("oculto");

    await cargarPanelAdmin();
  } catch (error) {
    console.error("Error de acceso administrador:", error);
    mensaje.textContent = "Ocurrió un error al iniciar sesión. Intentá nuevamente.";
  }
}

async function cerrarAdmin() {
  if (db) {
    await db.auth.signOut();
  }

  usuarioAdmin = null;

  document.getElementById("panelAdmin").classList.add("oculto");
  document.getElementById("loginAdmin").classList.remove("oculto");
  document.getElementById("adminClave").value = "";
}

async function cargarPanelAdmin() {
  if (!db || !usuarioAdmin) return;

  const zona = document.getElementById("contenidoAdmin");
  zona.innerHTML = "<p>Cargando panel...</p>";

  const { data: pedidos, error } = await db
    .from("orders")
    .select("*")
    .order("created_at", { ascending: false })
    .limit(100);

  if (error) {
    console.error("Error cargando pedidos:", error);
    zona.textContent =
      "No se pudieron cargar los pedidos. Revisá las políticas de Supabase.";
    return;
  }

  zona.innerHTML = `
    <h3>Pedidos recibidos</h3>
    <button type="button" onclick="cargarPanelAdmin()">Actualizar pedidos</button>
    <div style="overflow:auto">
      <table style="width:100%;border-collapse:collapse;margin-top:12px">
        <thead>
          <tr>
            <th style="text-align:left;padding:8px">Pedido</th>
            <th style="text-align:left;padding:8px">Cliente</th>
            <th style="text-align:left;padding:8px">Total</th>
            <th style="text-align:left;padding:8px">Estado</th>
            <th style="text-align:left;padding:8px">Acción</th>
          </tr>
        </thead>
        <tbody>
          ${(pedidos || []).map(p => `
            <tr>
              <td style="padding:8px;border-top:1px solid #ddd">
                ${escapar(p.order_number || p.id)}
              </td>
              <td style="padding:8px;border-top:1px solid #ddd">
                ${escapar(p.customer_name || "")}<br>
                ${escapar(p.customer_phone || "")}
              </td>
              <td style="padding:8px;border-top:1px solid #ddd">
                ${dinero(p.total)}
              </td>
              <td style="padding:8px;border-top:1px solid #ddd">
                ${escapar(p.order_status || "pendiente")}
              </td>
              <td style="padding:8px;border-top:1px solid #ddd">
                <button
                  type="button"
                  onclick="confirmarPedido(${Number(p.id)})"
                  ${p.order_status === "confirmed" || p.order_status === "cancelled" ? "disabled" : ""}>
                  Confirmar pedido
                </button>
              </td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    </div>
    <hr>
    <h3>Productos</h3>
    <p>Desde esta sección podés revisar el catálogo y agregar productos.</p>
    <button type="button" onclick="formularioProducto()">Agregar producto</button>
    <div id="formNuevoProducto"></div>
    <div id="listaAdminProductos"></div>
  `;

  await listarProductosAdmin();
}

async function confirmarPedido(id) {
  if (!usuarioAdmin || !db) {
    alert("Iniciá sesión como administrador.");
    return;
  }

  if (!confirm("¿Confirmar el pedido y descontar las cantidades del stock?")) {
    return;
  }

  try {
    const { data, error } = await db.rpc("admin_confirm_store_order", {
      p_order_id: id
    });

    if (error || data?.success === false) {
      console.error("Error confirmando pedido:", error || data);
      alert("No se pudo confirmar el pedido. Revisá el stock y los permisos.");
      return;
    }

    alert("Pedido confirmado.");
    await cargarPanelAdmin();
  } catch (error) {
    console.error(error);
    alert("Ocurrió un error al confirmar el pedido.");
  }
}

async function listarProductosAdmin() {
  if (!db || !usuarioAdmin) return;

  const zona = document.getElementById("listaAdminProductos");
  if (!zona) return;

  const { data, error } = await db
    .from("products")
    .select("*")
    .order("name");

  if (error) {
    console.error("Error cargando productos para administración:", error);
    zona.textContent = "No se pudieron cargar los productos.";
    return;
  }

  zona.innerHTML = `
    <div style="overflow:auto">
      <table style="width:100%;border-collapse:collapse">
        <thead>
          <tr>
            <th>Producto</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Visible</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          ${(data || []).map(p => `
            <tr>
              <td>${escapar(p.name)}</td>
              <td>${dinero(p.price)}</td>
              <td>${Number(p.stock) || 0}</td>
              <td>${p.active ? "Sí" : "No"}</td>
              <td>
                <button
                  type="button"
                  onclick="cambiarVisibilidad(${Number(p.id)},${!p.active})">
                  ${p.active ? "Ocultar" : "Mostrar"}
                </button>
              </td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    </div>
  `;
}

async function cambiarVisibilidad(id, activo) {
  if (!db || !usuarioAdmin) {
    alert("Iniciá sesión como administrador.");
    return;
  }

  const { error } = await db
    .from("products")
    .update({
      active: activo,
      updated_at: new Date().toISOString()
    })
    .eq("id", id);

  if (error) {
    console.error("Error cambiando visibilidad:", error);
    alert("No se pudo cambiar la visibilidad del producto.");
    return;
  }

  await cargarCatalogo();
  await listarProductosAdmin();
}

async function formularioProducto() {
  if (!db || !usuarioAdmin) {
    alert("Iniciá sesión como administrador.");
    return;
  }

  const zona = document.getElementById("formNuevoProducto");
  const { data: cats, error } = await db
    .from("categories")
    .select("*")
    .order("sort_order");

  if (error) {
    console.error("Error cargando categorías:", error);
    zona.textContent = "No se pudieron cargar las categorías.";
    return;
  }

  zona.innerHTML = `
    <form id="nuevoProducto" class="panel" style="margin-top:12px">
      <h3>Nuevo producto</h3>
      <label for="npNombre">Nombre</label>
      <input id="npNombre" required maxlength="140">

      <label for="npCategoria">Categoría</label>
      <select id="npCategoria" required>
        ${(cats || []).map(c => `
          <option value="${Number(c.id)}">${escapar(c.name)}</option>
        `).join("")}
      </select>

      <label for="npDescripcion">Descripción</label>
      <textarea id="npDescripcion" rows="2"></textarea>

      <label for="npPrecio">Precio en pesos</label>
      <input id="npPrecio" type="number" min="0" step="0.01" required>

      <label for="npUnidad">Unidad (kg, bandeja, unidad…)</label>
      <input id="npUnidad" value="kg" required>

      <label for="npStock">Stock</label>
      <input id="npStock" type="number" min="0" step="0.01" value="0">

      <label for="npImagen">URL de fotografía (opcional)</label>
      <input id="npImagen" type="url" placeholder="https://...">

      <button type="submit" class="principal">Guardar producto</button>
      <div id="npResultado" aria-live="polite"></div>
    </form>
  `;

  document.getElementById("nuevoProducto").onsubmit = async function(event) {
    event.preventDefault();

    if (!usuarioAdmin) {
      document.getElementById("npResultado").textContent =
        "Tu sesión de administrador no está activa.";
      return;
    }

    const precio = Number(document.getElementById("npPrecio").value);
    const stock = Number(document.getElementById("npStock").value) || 0;

    if (!Number.isFinite(precio) || precio < 0 ||
        !Number.isFinite(stock) || stock < 0) {
      document.getElementById("npResultado").textContent =
        "Revisá el precio y el stock.";
      return;
    }

    const fila = {
      name: document.getElementById("npNombre").value.trim(),
      category_id: Number(document.getElementById("npCategoria").value),
      description: document.getElementById("npDescripcion").value.trim(),
      price: precio,
      unit: document.getElementById("npUnidad").value.trim(),
      stock,
      image_url: document.getElementById("npImagen").value.trim() || null,
      active: true,
      featured: false
    };

    const boton = this.querySelector('button[type="submit"]');
    boton.disabled = true;
    boton.textContent = "Guardando...";

    try {
      const { error } = await db.from("products").insert(fila);

      if (error) {
        console.error("Error guardando producto:", error);
        document.getElementById("npResultado").textContent =
          "Error al guardar. Revisá los datos y los permisos de Supabase.";
        return;
      }

      alert("Producto agregado.");
      await cargarCatalogo();
      await cargarPanelAdmin();

    } catch (error) {
      console.error(error);
      document.getElementById("npResultado").textContent =
        "Ocurrió un error al guardar el producto.";
    } finally {
      boton.disabled = false;
      boton.textContent = "Guardar producto";
    }
  };
}

/* =========================================================
   INICIO DE LA TIENDA
   ========================================================= */

actualizarEntrega();
cargarCatalogo();
</script>

